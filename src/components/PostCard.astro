---
import { Image } from "astro:assets";
import { formatDate, postUrl, readingTime, type Post } from "../lib/posts";
import { youtubeThumbnail } from "../lib/youtube";

interface Props {
  post: Post;
  /** Show the video thumbnail / cover image at the top of the card. */
  media?: boolean;
}

const { post, media = true } = Astro.props;
const { title, description, date, tags, youtube, cover, draft } = post.data;
const thumb = media && !cover && youtube ? await youtubeThumbnail(youtube) : undefined;
const minutes = readingTime(post.body);
---

<a href={postUrl(post)} class="card card-hover spotlight group flex h-full flex-col overflow-hidden">
  {
    media && (cover || thumb) && (
      <div class="relative aspect-video overflow-hidden border-b border-slate-200/80 bg-slate-900 dark:border-slate-800">
        {cover ? (
          <Image
            src={cover}
            alt=""
            width={640}
            densities={[1, 2]}
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          />
        ) : (
          <Image
            src={thumb!}
            alt=""
            width={640}
            height={360}
            densities={[1, 2]}
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          />
        )}
        {youtube && (
          <span class="absolute left-3 top-3 inline-flex items-center gap-1 rounded-full bg-slate-950/75 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-white backdrop-blur">
            <svg viewBox="0 0 24 24" class="h-3 w-3" fill="currentColor" aria-hidden="true">
              <path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11-6.86a1 1 0 0 0 0-1.72l-11-6.86A1 1 0 0 0 8 5.14Z" />
            </svg>
            Video
          </span>
        )}
      </div>
    )
  }

  <div class="flex flex-1 flex-col p-6">
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-medium text-slate-500 dark:text-slate-400">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      <span class="text-slate-300 dark:text-slate-600">·</span>
      <span>{minutes} min read</span>
      {
        youtube && !(media && thumb) && (
          <>
            <span class="text-slate-300 dark:text-slate-600">·</span>
            <span class="text-blue-600 dark:text-blue-300">▶ Video</span>
          </>
        )
      }
      {
        draft && (
          <span class="rounded-full border border-amber-300 bg-amber-50 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-amber-700 dark:border-amber-700/60 dark:bg-amber-900/30 dark:text-amber-300">
            Draft
          </span>
        )
      }
    </div>

    <h3 class="mt-2 text-lg font-bold leading-snug text-slate-900 transition-colors group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-300">
      {title}
    </h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
      {description}
    </p>

    {
      tags.length > 0 && (
        <div class="mt-5 flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <span class="rounded-md bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">
              {tag}
            </span>
          ))}
        </div>
      )
    }
  </div>
</a>
