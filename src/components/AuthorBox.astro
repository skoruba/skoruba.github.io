---
import { Github, Globe, Linkedin, Mail, Twitter } from "lucide-react";
import jan from "../images/jan.png";
import { Image } from "astro:assets";

const links = [
  { label: "Website", href: "https://skoruba.com/", icon: Globe },
  { label: "GitHub", href: "https://github.com/skoruba", icon: Github },
  { label: "LinkedIn", href: "https://linkedin.com/in/skoruba", icon: Linkedin },
  { label: "X", href: "https://x.com/skoruba", icon: Twitter },
  { label: "Email", href: "mailto:jan@skoruba.com", icon: Mail },
];
---

<aside class="card relative mt-16 overflow-hidden p-6 sm:p-8" aria-label="About the author">
  <div class="absolute -right-24 -top-24 h-64 w-64 rounded-full bg-blue-400/15 blur-3xl"></div>

  <div class="relative flex flex-col gap-5 sm:flex-row sm:items-start sm:gap-6">
    <div class="relative shrink-0 self-start">
      <div
        class="absolute -inset-1 rounded-full bg-gradient-to-br from-blue-400 via-blue-500 to-blue-300 opacity-70 blur-sm"
      >
      </div>
      <Image
        src={jan}
        alt="Jan Škoruba"
        width={160}
        height={160}
        class="relative h-20 w-20 rounded-full border-4 border-white object-cover shadow-lg dark:border-slate-900"
      />
    </div>

    <div class="min-w-0">
      <p class="text-lg font-bold text-slate-900 dark:text-white">Jan Škoruba</p>
      <p class="text-sm font-medium text-slate-500 dark:text-slate-400">
        Identity Engineer · Prague, Czech Republic
      </p>
      <p class="mt-3 max-w-xl leading-relaxed text-slate-600 dark:text-slate-400">
        Jan builds open-source tooling for secure OpenID Connect and OAuth deployments and
        maintains the Skoruba Admin UI for Duende IdentityServer and ASP.NET Core Identity.
      </p>

      <ul class="mt-5 flex flex-wrap gap-2">
        {
          links.map(({ label, href, icon: Icon }) => (
            <li>
              <a
                href={href}
                target={href.startsWith("http") && !href.startsWith("https://skoruba.com") ? "_blank" : undefined}
                rel={href.startsWith("http") ? "noreferrer" : undefined}
                aria-label={label}
                title={label}
                class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-300 bg-white text-slate-700 transition-colors hover:border-blue-400 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-blue-500 dark:hover:text-blue-300"
              >
                <Icon className="h-[18px] w-[18px]" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</aside>
