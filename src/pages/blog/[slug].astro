---
import { render } from "astro:content";
import { getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import YouTube from "../../components/YouTube.astro";
import PostCard from "../../components/PostCard.astro";
import AuthorBox from "../../components/AuthorBox.astro";
import Comments from "../../components/Comments.astro";
import { formatDate, getPosts, postUrl, readingTime, type Post } from "../../lib/posts";
import { youtubeThumbnail } from "../../lib/youtube";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, date, updated, youtube, tags, cover, draft } = post.data;
const { Content } = await render(post);
const minutes = readingTime(post.body);
const canonical = new URL(postUrl(post), Astro.site).href;

// Link preview image: explicit cover > YouTube thumbnail > site default
let ogImage: string | undefined;
let ogWidth: number | undefined;
let ogHeight: number | undefined;
if (cover) {
  const img = await getImage({ src: cover, width: 1200, format: "jpg" });
  ogImage = img.src;
  ogWidth = Number(img.attributes.width) || undefined;
  ogHeight = Number(img.attributes.height) || undefined;
} else if (youtube) {
  ogImage = await youtubeThumbnail(youtube);
}

const others = (await getPosts()).filter((p) => p.id !== post.id).slice(0, 2);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  url: canonical,
  mainEntityOfPage: canonical,
  keywords: tags.join(", "),
  ...(ogImage && { image: new URL(ogImage, Astro.site).href }),
  author: {
    "@type": "Person",
    name: "Jan Škoruba",
    url: "https://skoruba.com/",
  },
  ...(youtube && {
    video: {
      "@type": "VideoObject",
      name: title,
      description,
      uploadDate: date.toISOString(),
      thumbnailUrl: ogImage,
      embedUrl: `https://www.youtube-nocookie.com/embed/${youtube}`,
      contentUrl: `https://www.youtube.com/watch?v=${youtube}`,
    },
  }),
};
---

<BaseLayout
  title={title}
  description={description}
  image={ogImage}
  imageAlt={title}
  imageWidth={ogWidth}
  imageHeight={ogHeight}
  type="article"
  publishedTime={date}
  modifiedTime={updated}
  jsonLd={jsonLd}
  noindex={draft}
>
  <article class="mx-auto max-w-3xl pb-8 pt-10 sm:pt-14">
    <a
      href="/blog/"
      class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-600 transition-colors hover:text-blue-600 dark:text-slate-400 dark:hover:text-blue-300"
    >
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M19 12H5M12 19l-7-7 7-7" />
      </svg>
      All articles
    </a>

    <header class="mt-6 animate-slide-up">
      {
        (tags.length > 0 || draft) && (
          <ul class="flex flex-wrap gap-2">
            {draft && (
              <li class="inline-flex items-center rounded-full border border-amber-300 bg-amber-50 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-amber-700 dark:border-amber-700/60 dark:bg-amber-900/30 dark:text-amber-300">
                Draft · not published
              </li>
            )}
            {tags.map((tag) => (
              <li class="pill">{tag}</li>
            ))}
          </ul>
        )
      }
      <h1 class="mt-5 text-3xl font-extrabold leading-tight tracking-tight text-slate-900 dark:text-white sm:text-4xl lg:text-[2.75rem] lg:leading-[1.12]">
        {title}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-slate-600 dark:text-slate-400 sm:text-xl">
        {description}
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2 border-y border-slate-200/80 py-4 text-sm text-slate-600 dark:border-slate-800 dark:text-slate-400">
        <span class="font-semibold text-slate-800 dark:text-slate-200">Jan Škoruba</span>
        <span class="text-slate-300 dark:text-slate-600">·</span>
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {
          updated && (
            <>
              <span class="text-slate-300 dark:text-slate-600">·</span>
              <span>
                Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
              </span>
            </>
          )
        }
        <span class="text-slate-300 dark:text-slate-600">·</span>
        <span>{minutes} min read</span>
      </div>
    </header>

    {youtube && <YouTube id={youtube} title={title} />}

    <div class="prose-article mt-10">
      <Content components={{ YouTube }} />
    </div>

    <AuthorBox />
    <Comments term={`blog/${post.id}`} />
  </article>

  {
    others.length > 0 && (
      <section class="mx-auto max-w-5xl py-12">
        <h2 class="mb-6 text-center text-xl font-bold text-slate-900 dark:text-white">More articles</h2>
        <div class:list={["mx-auto grid gap-5", others.length === 1 ? "max-w-xl" : "md:grid-cols-2"]}>
          {others.map((p) => (
            <PostCard post={p} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
