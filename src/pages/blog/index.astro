---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getPosts } from "../../lib/posts";

const posts = await getPosts();
---

<BaseLayout
  title="Blog"
  description="Articles and videos by Jan Škoruba on Duende IdentityServer, the Skoruba Admin UI, OpenID Connect and OAuth security."
>
  <section class="pb-16 pt-12 sm:pb-20 sm:pt-16">
    <div class="mx-auto mb-12 max-w-2xl animate-slide-up text-center">
      <span class="pill">Blog</span>
      <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-5xl">
        <span class="text-gradient">Articles &amp; videos</span>
      </h1>
      <p class="mt-4 text-base text-slate-600 dark:text-slate-400 sm:text-lg">
        Notes on Duende IdentityServer, the Admin UI, OpenID Connect and OAuth security.
      </p>
      <a
        href="/rss.xml"
        class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 transition-colors hover:text-blue-600 dark:text-slate-400 dark:hover:text-blue-300"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" /><circle cx="5" cy="19" r="1" />
        </svg>
        RSS feed
      </a>
    </div>

    {
      posts.length === 0 ? (
        <p class="text-center text-slate-500 dark:text-slate-400">No articles yet.</p>
      ) : (
        <div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-2">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
